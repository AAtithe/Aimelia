# Copy to .env.local for local development. In production every value is set in Vercel.

# Local database with no server (production uses the Neon integration's DATABASE_URL)
DATABASE_URL=pglite:./.data

# Required
AIMELIA_ACCESS_KEY=          # long random string; you enter it once to sign in
ENCRYPTION_KEY=              # at least 32 random characters; encrypts Microsoft tokens and signs sessions
AIMELIA_OWNER_EMAIL=         # the only Microsoft 365 account allowed to connect
CRON_SECRET=                 # Vercel sends it with each cron call
APP_URL=http://localhost:3000

# Microsoft 365 (Entra app registration)
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# AI: one or both
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: morning push
TEAMS_WEBHOOK_URL=
NTFY_URL=
NTFY_TOKEN=

# Optional: read-only lookups
WSCIP_EMAIL=
WSCIP_PASSWORD=
PCC_EMAIL=
PCC_PASSWORD=
